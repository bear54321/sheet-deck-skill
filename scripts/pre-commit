#!/bin/bash
# commit 前自動跑簡報檢查，讓規則不必靠人記得：
#   check_deck.py     每份簡報有自己的 data-deck（存檔鍵名），不能用網址
#   check_ai_calls.py AI 請求經過 httpJSON()（遇到 5xx 會重試）
#   test_migrate.py   舊存檔轉換集中在 MIGRATIONS，用舊存檔範例實測（需要 Node.js）
# 檢查的是「這次要 commit 的版本」（暫存區），不是工作目錄裡還沒 add 的改動。
# 安裝（每台電腦一次）：ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
set -u
root=$(git rev-parse --show-toplevel)

# Claude 載入的 skill 必須就是這個 repo（捷徑或直接 clone 在那裡），不能是另一份手動複製的副本
skill="$HOME/.claude/skills/sheet-deck"
if [ -e "$skill" ] && [ "$(cd "$skill" && pwd -P)" != "$(cd "$root" && pwd -P)" ]; then
  echo "✗ $skill 是另一份副本，不是這個 repo（$root）。"
  echo "  規則：Claude 載入的 sheet-deck skill 只能是這個 repo 本身，否則在這裡的修改不會生效、兩份會不一致。"
  echo "  修法：確認那份沒有獨有的改動後移到垃圾桶，再執行 ln -s \"$root\" \"$skill\""
  echo "commit 已取消。"
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

files=()
while IFS= read -r -d '' f; do
  mkdir -p "$tmp/$(dirname "$f")"
  git show ":$f" > "$tmp/$f"
  grep -q 'sheet-deck:' "$tmp/$f" && files+=("$tmp/$f")   # 只檢查 sheet-deck 簡報
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.html')

[ ${#files[@]} -eq 0 ] && exit 0
cd "$tmp" || exit 1
rel=("${files[@]#$tmp/}")
fail=0
python3 "$root/scripts/check_deck.py" "${rel[@]}" || fail=1
python3 "$root/scripts/check_ai_calls.py" "${rel[@]}" || fail=1
python3 "$root/scripts/test_migrate.py" "${rel[@]}" || fail=1
if [ $fail -ne 0 ]; then
  echo
  echo "commit 已取消：上面的簡報檢查沒通過。照訊息裡的「修法」改好、git add 之後再 commit。"
  exit 1
fi
